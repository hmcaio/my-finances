# Dev env vars (F014, for symmetry with .env.production — see docs/features/F014-cicd-production-packaging/spec.md).
# Not currently read by app code: F001's src/api/health.ts still hardcodes
# http://localhost:8080 directly (dev-only, PRD S7.1 localhost-only assumption) rather than
# reading import.meta.env. Loaded automatically by Vite for `npm run dev` / `vite build --mode development`.
VITE_API_BASE_URL=http://localhost:8080
