# Dev env vars. Loaded automatically by Vite for `npm run dev` / `vite build --mode development`.
# Includes the /api prefix so every call site under src/api can use a bare relative path
# (e.g. '/categories') regardless of environment - see src/api/client.ts.
VITE_API_BASE_URL=http://localhost:8080/api
# Log level for src/utils/logger.ts (debug | info | warn | error | silent). Can be overridden at
# runtime with localStorage['logLevel'].
VITE_LOG_LEVEL=debug
