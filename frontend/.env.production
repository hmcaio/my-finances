# Prod env vars (F014). Vite inlines these at build time (frontend/Dockerfile's build stage
# runs `npm run build`, which picks this file up automatically for the production mode).
# Relative path: nginx.conf reverse-proxies /api/ to the backend container, so the browser
# calls the API same-origin — no absolute host/port and no CORS configuration needed.
VITE_API_BASE_URL=/api
# Log level for src/utils/logger.ts, baked in at build time. Raise it at runtime without a rebuild
# with localStorage.setItem('logLevel', 'debug') in devtools.
VITE_LOG_LEVEL=warn
