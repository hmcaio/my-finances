# openapi-typescript's peer range (typescript ^5.x) hasn't caught up to the TypeScript
# version this Vite template ships (6.x) yet. legacy-peer-deps keeps `npm install` a
# single, zero-flag command for a clean checkout; revisit once openapi-typescript widens
# its peer range.
legacy-peer-deps=true
# Native `npm install`/`npm ci` refuse a Node outside package.json's `engines` (pinned in
# .nvmrc, which CI and the Dockerfile follow) instead of failing later in odd ways.
engine-strict=true
