# openapi-typescript's peer range (typescript ^5.x) hasn't caught up to the TypeScript
# version this Vite template ships (6.x) yet. legacy-peer-deps keeps `npm install` a
# single, zero-flag command for a clean checkout; revisit once openapi-typescript widens
# its peer range.
legacy-peer-deps=true
# Native `npm install`/`npm ci` refuse a Node outside package.json's `engines` (pinned in
# .nvmrc, which CI and the Dockerfile follow) instead of failing later in odd ways.
engine-strict=true
# Resolve only versions published at least 7 days ago (npm >= 11.10; the pinned Node 24 ships
# 11.19), so a freshly published, possibly malicious release is not picked up by `npm install`.
# Dependabot deliberately skips npm (.github/dependabot.yml), so this is the only delay on npm.
# For an urgent security fix, override it for one install with the `--min-release-age` flag.
min-release-age=7
