# Backend (Gradle/Java)
backend/.gradle/
backend/build/
backend/bin/
!backend/gradle/wrapper/gradle-wrapper.jar
*.class
hs_err_pid*

# Frontend (Node/Vite)
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# Environment secrets (see F014, ADR 0007) — never commit
.env

# rclone config for F018's optional off-site backup push (ADR 0015) — holds remote credentials,
# same gitignore convention as .env. Never commit.
rclone.conf

# Agent worktrees (created by subagents via isolation:"worktree", e.g. the implement-feature skill)
.claude/worktrees/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
# Rolled/gzipped backend log archives (backend.log.2026-09-19.0.gz) are not matched by *.log (F016)
backend/logs/

# F018 backup sidecar end-to-end test scratch dir (backup/test/e2e.sh), normally removed by its
# own cleanup trap - left behind only if the script is killed mid-run.
backup/.e2e-tmp-*/
