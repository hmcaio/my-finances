# Copy to .env (gitignored) and fill in real values before running:
#   docker compose -f docker-compose.prod.yml up -d
# Never commit the real .env file.

# Postgres credentials (used by the postgres service, and by the backend to connect to it).
POSTGRES_DB=myfinances
POSTGRES_USER=myfinances
POSTGRES_PASSWORD=change-me

# Backend datasource target — DB_HOST/DB_PORT must match the postgres service's name/port on
# the docker-compose.prod.yml network (the default "postgres"/5432 works unless you rename the
# service). DB_NAME/DB_USER/DB_PASSWORD reuse the POSTGRES_* values above via the compose file.
DB_HOST=postgres
DB_PORT=5432

# Which published image version to run for backend + frontend (see
# .github/workflows/ci.yml): a short git SHA or "latest" from a main push, or a "vX.Y.Z"
# release tag for a reproducible, pinned deploy.
IMAGE_TAG=latest

# Host port the frontend's nginx is published on (http://localhost:<this>). Optional — defaults
# to 8081 in docker-compose.prod.yml if unset.
FRONTEND_PORT=8081

# Backend log level (F016): INFO by default; set DEBUG when chasing something, then recreate the
# backend (`docker compose -f docker-compose.prod.yml up -d`). Optional.
LOG_LEVEL=INFO

# IANA time zone the backend uses for "today" (e.g. America/Sao_Paulo). Defaults to UTC, which
# differs from your browser's local time in the evening; set it to the zone you use the app in.
# Also read by the dev `full` profile (docker-compose.yml). Optional.
TZ=UTC

# --- Backups (F018, ADR 0015) ---------------------------------------------------------------

# Public half of an age keypair the backup sidecar encrypts every dump with - generate one with
# `docker compose -f docker-compose.prod.yml run --rm --no-deps backup backup-keygen` (or
# `age-keygen` locally) and put only the recipient (the "age1..." line) here. The matching
# private key is NEVER put in this file or stored anywhere on this host - see the keygen
# output's own warning and the README. Required: the sidecar refuses to run without it, and the
# backend's /api/backup-status will show UNKNOWN until the first backup attempt.
BACKUP_AGE_RECIPIENT=

# Where backups are written. Unset (default): the external named volume
# my-finances-backups-prod, which `docker compose down -v` cannot remove - create it once with
# `docker volume create my-finances-backups-prod` before the first `up -d`. Set to an absolute
# host path (e.g. a folder synced by Dropbox/OneDrive/Syncthing) for an off-machine copy with no
# cloud credentials in this file; any value containing a path separator is treated as that bind
# mount instead of the named volume. Optional.
BACKUP_DIR=

# Numeric uid:gid the backup sidecar drops to for every actual backup (the container briefly
# starts as root just to chown a fresh volume/bind mount, then re-execs as this uid:gid for
# everything else - it never does the real work as root), so files land with predictable
# ownership on a bind-mounted host folder - matters most on a plain Linux host; Docker Desktop
# for Windows/macOS is more forgiving. Both default to 1000 if unset. Optional.
BACKUP_UID=1000
BACKUP_GID=1000

# How many hours old the last *successful* backup can be before the sidecar treats it as stale
# and takes a new one on its next catch-up check (at container start, then hourly) - see ADR
# 0015's catch-up trigger. Default 20 (comfortably under the backend's own 48h STALE threshold
# for /api/backup-status) if unset. Optional.
BACKUP_MAX_AGE_HOURS=20

# Name of an rclone remote (as configured in rclone.conf, e.g. "myremote:myfinances-backups") to
# additionally push every encrypted backup to - useful on a VPS with no synced folder of its own.
# Off by default (empty). When set, also create an rclone.conf file next to this one (gitignored,
# same convention as .env itself) with that remote's credentials; docker-compose.prod.yml mounts
# it read-only into the sidecar automatically if present. A push failure is treated as a backup
# failure (shows as FAILING in the status/banner) - see the README for rclone setup. Optional.
BACKUP_RCLONE_REMOTE=
